add(`What is <b>${n}</b>’s relationship in the family?`,X.r,P.map(p=>p.r));
add(`Which month is <b>${n}</b>’s birthday?`,mon(X),MN);
add(`Where is <b>${n}</b>’s home?`,X.w,P.map(p=>p.w));
add(`Which family branch is <b>${n}</b> in?`,X.d,P.map(p=>p.d));
if(par)add(`Who is <b>${n}</b>’s parent?`,par.n,P.filter(p=>p.id!==X.id).map(p=>p.n));
if(tg.length)add(`Which of these is an interest of <b>${n}</b>?`,tg[0],P.reduce((a,p)=>a.concat(tgs(p)),[]).filter(t=>tg.indexOf(t)<0));
