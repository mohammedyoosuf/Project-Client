$("aX").onclick=function(){$("adm").hidden=true};
$("aClr").onclick=function(){clr();msg("")};
$("aFile").onchange=function(){
  var f=this.files[0];if(!f)return;var r=new FileReader();
  r.onload=function(){var im=new Image();im.onload=function(){var s=160,c=document.createElement("canvas");c.width=c.height=s;var m=Math.min(im.width,im.height);c.getContext("2d").drawImage(im,(im.width-m)/2,(im.height-m)/2,m,m,0,0,s,s);pic=c.toDataURL("image/jpeg",.8);$("aPrev").innerHTML='<img alt="" src="'+pic+'">'};im.src=r.result};
  r.readAsDataURL(f);
};
$("aSave").onclick=function(){
  var n=$("aName").value.trim();if(!n){msg("Name is required.");return}
  var nid=ed||Math.max.apply(null,P.map(function(x){return x.id}).concat([0]))+1;
  var p=clean({id:nid,n:n,r:$("aRole").value.trim(),d:$("aDept").value.trim(),m:$("aMgr").value,e:$("aEmail").value.trim(),w:$("aWh").value.trim(),l:$("aLoc").value.trim(),ph:$("aPhone").value.trim(),bd:$("aBd").value,jd:$("aJd").value,f:$("aFun").value.trim(),img:pic});
  var was=ed;
  if(was){P=P.map(function(x){return x.id===was?p:x})}else{P.push(p)}
  store();render();lst();clr();msg(unesc(p.n)+(was?" updated.":" added."));
};
$("aList").onclick=function(e){
  var b=e.target.closest("button");if(!b)return;
  if(b.dataset.e){edit(+b.dataset.e);return}
  if(b.dataset.d){
    if(b.dataset.arm!=="1"){b.dataset.arm="1";b.textContent="Sure?";return}
    var id=+b.dataset.d,x=byId[id];
    P=P.filter(function(p){return p.id!==id});P.forEach(function(p){if(p.m===id)p.m=x.m});
    store();render();lst();clr();msg("Deleted. Their kids now report to the deleted person's manager.");
  }
};
$("aShow").onclick=function(){$("aJson").value=JSON.stringify(P,null,1)};
$("aLoad").onclick=function(){
