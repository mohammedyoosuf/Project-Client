];
var TK={auto:{count:1,hire:1,bd:1,an:1,nj:1},speed:50,items:[{i:"📢",t:"Welcome to our family tree!",until:"",on:true}]};
try{var st0=localStorage.getItem("fam_ticker");if(st0){var s1=JSON.parse(st0);TK.speed=s1.speed||50;TK.items=s1.items||[];TK.auto=Object.assign(TK.auto,s1.auto||{})}}catch(e){}
