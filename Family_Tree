function quiz(id){const X=byId[id];G={id,g:'quiz',q:buildQ(X),i:0,s:0,lock:false};if(!G.q.length){$('gb').innerHTML=head(X,'Who is it?')+`<p class='asub'>Not enough details for ${X.n} yet. Add a relationship, birthday and home in the Admin panel to play.</p><button data-go='menu'>Back</button>`;return}ask()}
function ask(){const X=byId[G.id],q=G.q[G.i];if(!q)return end();$('gb').innerHTML=head(X,'Who is it?')+`<small class='mut'>Question ${G.i+1} of ${G.q.length} · Score ${G.s}</small><h3>${q.t}</h3><div class='gopts'>${q.o.map((o,i)=>`<button data-a='${i}'>${o}</button>`).join('')}</div>`}
function answer(i){const q=G.q[G.i];G.lock=true;$('gb').querySelectorAll('[data-a]').forEach((b,k)=>{if(k===q.c)b.classList.add('ok');else if(k===i)b.classList.add('bad');b.disabled=true});if(i===q.c)G.s++;const t=G;setTimeout(()=>{if(G!==t)return;G.i++;G.lock=false;ask()},900)}
function end(){const X=byId[G.id],n=G.q.length,need=Math.min(4,n),win=G.s>=need;rec(G.id,win);$('gb').innerHTML=head(X,'Who is it?');result(win,`You scored ${G.s} out of ${n}.`+(win?'':` You need ${need} to win.`))}
function mem(id){const X=byId[id],ps=[X].concat(shuf(P.filter(p=>p.id!==id)).slice(0,5)),cs=[];ps.forEach(p=>{cs.push({p:p.id,t:'f'});cs.push({p:p.id,t:'n'})});G={id,g:'mem',c:shuf(cs),open:[],done:{},moves:0,lock:false,pairs:ps.length};drawMem()}
function drawMem(){const X=byId[G.id];$('gb').innerHTML=head(X,'Memory match')+`<small class='mut'>Match each face with its name · Moves ${G.moves} · Win in ${G.pairs*2+3} moves or fewer</small><div class='gmem'>${G.c.map((c,i)=>{const p=byId[c.p],up=G.done[c.p]||G.open.includes(i);return `<button class='gc${up?' up':''}${G.done[c.p]?' ok':''}' data-c='${i}'${up?' disabled':''}>${up?(c.t==='f'?`<span class='mv' style='--c:${COL[p.d]}'>${face(p)}</span>`:`<b>${p.n}</b>`):'?'}</button>`}).join('')}</div>`}
function flip(i){if(G.lock||G.open.includes(i)||G.done[G.c[i].p])return;G.open.push(i);
if(G.open.length===2){G.moves++;const [a,b]=G.open.map(k=>G.c[k]);
if(a.p===b.p){G.done[a.p]=1;G.open=[];drawMem();if(Object.keys(G.done).length===G.pairs){const win=G.moves<=G.pairs*2+3;rec(G.id,win);drawMem();result(win,`Finished in ${G.moves} moves.`+(win?'':` Try for ${G.pairs*2+3} or fewer to win.`))}return}
G.lock=true;drawMem();const t=G;setTimeout(()=>{if(G!==t)return;G.open=[];G.lock=false;drawMem()},800);return}
drawMem()}
window.openGames=(id,g)=>{if(!byId[id]){if(!P.length)return;id=P[Math.floor(Math.random()*P.length)].id}$('gm').hidden=false;g==='quiz'?quiz(id):g==='mem'?mem(id):menu(id)};
$('gb').addEventListener('click',e=>{const go=e.target.closest('[data-go]');if(go){const k=go.dataset.go;k==='quiz'?quiz(G.id):k==='mem'?mem(G.id):menu(G.id);return}const a=e.target.closest('[data-a]');if(a&&!G.lock){answer(+a.dataset.a);return}const c=e.target.closest('[data-c]');if(c)flip(+c.dataset.c)});
$('gb').addEventListener('change',e=>{if(e.target.id==='gWho')menu(+e.target.value)});
$('gX').onclick=()=>{$('gm').hidden=true;G={}};
$('gm').addEventListener('click',e=>{if(e.target===$('gm')){$('gm').hidden=true;G={}}});
document.addEventListener('keydown',e=>{if(e.key==='Escape'&&!$('gm').hidden){$('gm').hidden=true;G={}}});
$('join').insertAdjacentHTML('beforebegin',`<section class='depts' id='games'><h2 class='sh'>🎮 Family games</h2><p class='asub'>Pick a family member, play a game about them and win trophies for them.</p><div class='gsec'><div class='dc'><h4>Choose a player</h4><select id='gSel'></select><div class='apbar'><button class='pri' data-gp='quiz'>🧠 Who is it?</button><button class='pri' data-gp='mem'>🃏 Memory match</button><button data-gp='rand'>🎲 Surprise me</button></div></div><div class='dc'><h4>🏆 Champions</h4><div id='gBoard'></div></div></div></section>`);
function board(){const sel=$('gSel'),v=sel.value;sel.innerHTML=P.map(p=>`<option value='${p.id}'>${p.n} — ${p.r}</option>`).join('');if(v&&byId[v])sel.value=v;const top=P.map(p=>({p,w:wins(p.id)})).filter(x=>x.w>0).sort((a,b)=>b.w-a.w).slice(0,5);$('gBoard').innerHTML=top.length?top.map((x,i)=>`<div class='tr'><span>${['🥇','🥈','🥉','4️⃣','5️⃣'][i]}</span>${mv(x.p)}<div class='ti'><b>${x.p.n}</b><span>${x.p.r}</span></div><b>🏆 ${x.w}</b></div>`).join(''):`<p class='mut'>No wins yet. Be the first!</p>`}
document.addEventListener('click',e=>{const b=e.target.closest('[data-gplay]');if(b){openGames(+b.dataset.gplay);return}const g=e.target.closest('[data-gp]');if(g){let id=+$('gSel').value,k=g.dataset.gp;if(k==='rand'){id=P[Math.floor(Math.random()*P.length)].id;k=Math.random()<.5?'quiz':'mem'}openGames(id,k)}});
const pr=$('profile');new MutationObserver(()=>{if(pr.querySelector('.gplay'))return;const sh=pr.querySelector('.share button[data-id]');if(!sh)return;const id=+sh.dataset.id,p=byId[id];if(!p)return;pr.querySelector('.share').insertAdjacentHTML('afterend',`<div class='gplay'><button class='pri' data-gplay='${id}'>🎮 Play games for ${p.n} · 🏆 ${wins(id)}</button></div>`)}).observe(pr,{childList:true});
const _r=window.render;window.render=function(){_r.apply(this,arguments);board()};
board();
})();
</script><script>document.querySelectorAll("#adm details").forEach(function(d){if(/Join our team/.test(d.textContent.slice(0,90)))d.style.display="none"})</script></body>
