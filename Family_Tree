  var r=document.documentElement,dark=r.dataset.theme?r.dataset.theme==="dark":matchMedia("(prefers-color-scheme: dark)").matches;
  r.dataset.theme=dark?"light":"dark";};
var drawer=document.getElementById("drawer"),back=document.getElementById("back");
function open(id){
  var p=byId[id],k=kids[id]||[];
  var m=p.m?byId[p.m]:null,c=COL[p.d];
  function cell(a,b,x){return '<div class="cell"'+(x?' data-open="'+x+'"':'')+'><small>'+a+'</small><b>'+b+'</b></div>'}
