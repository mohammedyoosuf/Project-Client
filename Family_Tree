<div class='apm' id='gm' hidden role='dialog' aria-modal='true'><div class='apbox'><button class='apx' id='gX' aria-label='Close'>×</button><div id='gb'></div></div></div>
<script>
(function(){
const MK='fam_wins';let W={},G={};try{W=JSON.parse(localStorage.getItem(MK)||'{}')}catch(e){}
const wins=id=>(W[id]||{}).w||0;
const shuf=a=>{a=a.slice();for(let i=a.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[a[i],a[j]]=[a[j],a[i]]}return a};
const uniq=a=>a.filter((x,i)=>x&&a.indexOf(x)===i);
const tgs=p=>(p.s||'').split(',').map(x=>x.trim()).filter(Boolean);
const mon=p=>p.bd&&p.bd.length===10?MN[+p.bd.slice(5,7)-1]:'';
function rec(id,won){const o=W[id]=W[id]||{w:0,p:0};o.p++;if(won)o.w++;try{localStorage.setItem(MK,JSON.stringify(W))}catch(e){}board();badge()}
function badge(){const b=document.querySelector('[data-gplay]');if(b){const p=byId[+b.dataset.gplay];if(p)b.textContent='🎮 Play games for '+p.n+' · 🏆 '+wins(p.id)}}
function head(p,t){return `<div style='display:flex;gap:10px;align-items:center;margin:0 36px 10px 0'><span class='mv' style='--c:${COL[p.d]}'>${face(p)}</span><div><h2 style='margin:0;font-size:20px'>${t}</h2><small class='mut'>Playing for ${p.n} · 🏆 ${wins(p.id)} wins</small></div></div>`}
function result(win,msg){const X=byId[G.id];$('gb').insertAdjacentHTML('beforeend',`<div class='gres'><div class='okbig'>${win?'🏆':'💪'}</div><h3>${win?'You win!':'Good try!'}</h3><p>${msg}</p><div class='apbar' style='justify-content:center'><button class='pri' data-go='${G.g}'>Play again</button><button data-go='menu'>Games menu</button></div></div>`);if(win){confetti(120);say('🏆 <b>'+X.n+'</b> wins a trophy!',4500)}}
function menu(id){G={id,lock:false};const p=byId[id];$('gb').innerHTML=head(p,'Family games')+`<p class='asub'>Win a game to earn a 🏆 for ${p.n}.</p><div class='gmenu'><button class='pri' data-go='quiz'>🧠 Who is it? quiz</button><button class='pri' data-go='mem'>🃏 Memory match</button></div><label>Play for someone else</label><select id='gWho'>${P.map(x=>`<option value='${x.id}'${x.id===id?' selected':''}>${x.n}</option>`).join('')}</select>`}
function opts(ans,pool){let o=shuf(uniq(pool).filter(x=>x!==ans)).slice(0,3);o.push(ans);o=shuf(o);return{o,c:o.indexOf(ans)}}
function buildQ(X){const n=X.n,L=[],par=X.m?byId[X.m]:null,tg=tgs(X);
