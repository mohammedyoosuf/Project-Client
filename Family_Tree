var ed=null,pic="";
function T(x){return esc(unesc(x||""))}
function clean(p){return{id:+p.id,n:T(p.n)||"Unnamed",r:T(p.r),d:T(p.d)||"General",m:p.m?+p.m:null,e:T(p.e),w:T(p.w),l:T(p.l),ph:T(p.ph),bd:/^[0-9-]{5,10}$/.test(p.bd||"")?p.bd:"",jd:/^\d{4}-\d{2}-\d{2}$/.test(p.jd||"")?p.jd:"",f:T(p.f),s:T(p.s),img:/^data:image\//.test(p.img||"")?p.img:""}}
function store(){try{localStorage.setItem("fam_people",JSON.stringify(P))}catch(e){}}
function msg(t){$("aMsg").textContent=t}
function desc(id,o){(kids[id]||[]).forEach(function(c){o.push(c.id);desc(c.id,o)});return o}
function fillMgr(sel){
  var ex=ed?[ed].concat(desc(ed,[])):[];
  $("aMgr").innerHTML='<option value="">— Top level —</option>'+P.filter(function(p){return ex.indexOf(p.id)<0}).map(function(p){return '<option value="'+p.id+'">'+p.n+' — '+p.r+'</option>'}).join("");
  $("aMgr").value=sel||"";
}
function lst(){
  $("aList").innerHTML=P.map(function(p){return '<div class="ar"><div><b>'+p.n+'</b><span>'+p.r+' · '+p.d+'</span></div><button data-e="'+p.id+'">Edit</button><button data-d="'+p.id+'">Delete</button></div>'}).join("");
  $("aDl").innerHTML=Object.keys(COL).map(function(k){return '<option value="'+unesc(k).replace(/"/g,"&quot;")+'">'}).join("");
}
function clr(){
  ed=null;pic="";
  ["aName","aRole","aDept","aWh","aLoc","aEmail","aPhone","aBd","aJd","aFun"].forEach(function(i){$(i).value=""});
  $("aFile").value="";$("aPrev").innerHTML="";$("aSave").textContent="Add person";fillMgr("");
}
function edit(id){
  var p=byId[id];ed=id;pic=p.img||"";
  $("aName").value=unesc(p.n);$("aRole").value=unesc(p.r);$("aDept").value=unesc(p.d);$("aWh").value=unesc(p.w);$("aLoc").value=unesc(p.l);$("aEmail").value=unesc(p.e);$("aPhone").value=unesc(p.ph);$("aBd").value=p.bd&&p.bd.length===10?p.bd:"";$("aJd").value=p.jd||"";$("aFun").value=unesc(p.f);
  $("aPrev").innerHTML=pic?'<img alt="" src="'+pic+'">':"";$("aSave").textContent="Save changes";fillMgr(p.m);
  $("aName").focus();
}
