var byId={},kids={};
function ini(n){return n.split(" ").map(function(w){return w[0]}).slice(0,2).join("")}
function $(i){return document.getElementById(i)}
var CH="ABCDEFGHJKLMNPQRSTUVWXYZabcdefghkmnpqrstuvwxyz23456789#%&*";
function scramble(el,delay){
  var to=el.dataset.t||(el.dataset.t=el.textContent),n=to.length;
  if(matchMedia("(prefers-reduced-motion: reduce)").matches){el.textContent=to;return}
  var id=el._s=(el._s||0)+1,st=performance.now()+(delay||0),dur=500+n*28,last=0;
  (function f(t){
    if(el._s!==id)return;
    if(t-last>40){
      last=t;var k=Math.max(0,Math.min(1,(t-st)/dur)),out="";
      for(var i=0;i<n;i++){var c=to[i];out+=(c===" "||i<k*n)?c:CH[Math.floor(Math.random()*CH.length)]}
      el.textContent=out;
    }
    if(t<st+dur)requestAnimationFrame(f);else el.textContent=to;
  })(performance.now());
}
function countTo(el,to){
  var cur=+el.textContent||0;
  if(cur===to||matchMedia("(prefers-reduced-motion: reduce)").matches){el.textContent=to;return}
  var t0=performance.now();
  (function s(t){var k=Math.min((t-t0)/900,1);var v=cur+(to-cur)*(1-Math.pow(1-k,3));el.textContent=to%1?v.toFixed(1):Math.round(v);if(k<1)requestAnimationFrame(s)})(t0);
}
function esc(s){return String(s).replace(/[&<>"]/g,function(c){return{"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]})}
function unesc(s){var t=document.createElement("textarea");t.innerHTML=s||"";return t.value}
function face(p){return p.img?'<img alt="" data-i="'+ini(p.n)+'" src="'+p.img+'">':ini(p.n)}
function node(p){
  var k=kids[p.id]||[],c=COL[p.d];
  return '<li><div class="node" data-id="'+p.id+'" style="--c:'+c+'" tabindex="0">'+flag(p)+'<div class="av">'+face(p)+'</div><b>'+p.n+'</b><span>'+p.r+'</span><div class="extra">'+p.d+' · '+k.length+' kid'+(k.length===1?'':'s')+'</div></div>'+
  (k.length?'<ul>'+k.map(node).join("")+'</ul>':'')+'</li>';
}
function render(){
  byId={};kids={};
  P.forEach(function(p){COL[p.d];byId[p.id]=p;var k=p.m||null;(kids[k]=kids[k]||[]).push(p)});
  $("zoom").innerHTML='<ul class="tree">'+(kids[null]||[]).map(node).join("")+'</ul>';
  countTo($("count"),P.length);
  var ds={};P.forEach(function(p){ds[p.d]=1});
  var mk=Object.keys(kids).filter(function(k){return k!=="null"});
  countTo($("cDept"),Object.keys(ds).length);countTo($("cMgr"),mk.length);
  countTo($("cTop"),Math.max.apply(null,mk.map(function(k){return kids[k].length}).concat([0])));
  var cnt={};P.forEach(function(p){cnt[p.d]=(cnt[p.d]||0)+1});
  var mxn=Math.max.apply(null,Object.keys(cnt).map(function(k){return cnt[k]}).concat([1]));
  $("dgrid").innerHTML=Object.keys(cnt).map(function(k,i){return '<div class="dc rv" style="--c:'+COL[k]+';--w:'+Math.round(cnt[k]/mxn*100)+'%;--d:'+(i*.08)+'s"><h4><i></i>'+k+'</h4><strong class="dn" data-to="'+cnt[k]+'">0</strong><div class="bar"><u></u></div><small>people</small></div>'}).join("");
  dash();olist();joinRender();
  if(typeof watch==="function"&&typeof io!=="undefined"&&io)watch();
  var d=$("dept"),v=d.value;
  d.innerHTML='<option value="">All branches</option>'+Object.keys(COL).filter(function(k){return P.some(function(p){return p.d===k})}).map(function(k){return '<option>'+k+'</option>'}).join("");
  d.value=v;
  document.querySelectorAll(".node").forEach(function(n,i){n.style.animationDelay=Math.min(i*70,1400)+"ms"});
  if(window.rdy)filter();
  celeb();ticker();
}
var dept=$("dept");render();
var q=document.getElementById("q");
function filter(){
  var s=q.value.trim().toLowerCase(),d=dept.value,sv=$("skillF").value,any=s||d||sv;olist();
  document.querySelectorAll(".node").forEach(function(el){
    var p=byId[el.dataset.id],ok=(!s||(p.n+" "+p.r+" "+p.d+" "+(p.s||"")).toLowerCase().indexOf(s)>-1)&&(!d||p.d===d)&&(!sv||skl(p).indexOf(sv)>-1);
    el.classList.toggle("hit",!!any&&ok);el.classList.toggle("dim",!!any&&!ok);
  });
}
q.addEventListener("input",filter);dept.addEventListener("change",filter);
var canvas=document.getElementById("canvas");
document.querySelectorAll("[data-v]").forEach(function(b){b.addEventListener("click",function(){
  document.querySelectorAll("[data-v]").forEach(function(x){x.classList.remove("on")});b.classList.add("on");
  canvas.className="canvas "+b.dataset.v;});});
var z=1,zoom=document.getElementById("zoom");
function setZ(v){z=Math.max(.4,Math.min(1.6,v));zoom.style.transform="scale("+z+")"}
document.getElementById("zi").onclick=function(){setZ(z+.1)};
document.getElementById("zo").onclick=function(){setZ(z-.1)};
document.getElementById("fit").onclick=function(){setZ(1)};
document.getElementById("prt").onclick=function(){window.print()};
document.getElementById("pres").onclick=function(){try{canvas.requestFullscreen()}catch(e){}};
