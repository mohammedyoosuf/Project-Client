<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Our Family Tree</title>
<style>
:root{--bg:#f4f8f8;--card:#fff;--text:#12292b;--muted:#5d7476;--line:#b9d2d1;--brand:#00a99d;--brand-d:#007f76;--sel:#e0f6f4;color-scheme:light;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#0e1b1c;--card:#16292b;--text:#e6f2f1;--muted:#95b0ae;--line:#2f4d4f;--sel:#123c3a;color-scheme:dark}}
:root[data-theme="dark"]{--bg:#0e1b1c;--card:#16292b;--text:#e6f2f1;--muted:#95b0ae;--line:#2f4d4f;--sel:#123c3a;color-scheme:dark}
*{box-sizing:border-box}
html,body{margin:0}
body{background:var(--bg);color:var(--text);font:15px/1.5 system-ui,-apple-system,"Segoe UI",Roboto,sans-serif}
.site-header{display:flex;justify-content:space-between;align-items:center;padding:14px 20px;background:var(--card);border-bottom:1px solid var(--line)}
.brand{display:flex;align-items:center;gap:12px}
.logo{width:40px;height:40px;border-radius:10px;background:var(--brand);color:#fff;display:grid;place-items:center;font-weight:800}
.brand strong{display:block;line-height:1.2}.brand small{color:var(--muted)}
button{font:inherit;cursor:pointer;border:1px solid var(--line);background:var(--card);color:var(--text);border-radius:8px;padding:7px 12px}
button:hover{border-color:var(--brand)}
.header-actions{display:flex;gap:8px;align-items:center}
main{max-width:1200px;margin:0 auto;padding:20px}
.hero{display:flex;justify-content:space-between;gap:20px;align-items:center;flex-wrap:wrap;margin-bottom:20px}
.eyebrow{color:var(--brand-d);font-weight:700;font-size:12px;text-transform:uppercase;letter-spacing:.08em}
h1{margin:6px 0;font-size:clamp(26px,5vw,42px);line-height:1.1}h1 em{color:var(--brand);font-style:normal}
.hero p{color:var(--muted);margin:0}
.stat{background:var(--brand);color:#fff;border-radius:16px;padding:18px 28px;text-align:center}
.stat strong{font-size:38px;display:block;line-height:1}.stat small{opacity:.85}
.toolbar{display:flex;flex-wrap:wrap;gap:10px;align-items:center;margin-bottom:12px}
.toolbar input,.toolbar select{font:inherit;padding:8px 12px;border:1px solid var(--line);border-radius:8px;background:var(--card);color:var(--text)}
.toolbar input{min-width:220px;flex:1}
.grp{display:flex;gap:6px;margin-left:auto;flex-wrap:wrap}
.grp .on{background:var(--brand);color:#fff;border-color:var(--brand)}
.canvas{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:24px;overflow:auto;min-height:420px}
.zoom{transform-origin:top center;width:max-content;margin:0 auto;transition:transform .2s}
.tree,.tree ul{list-style:none;margin:0;padding:0;display:flex;justify-content:center;position:relative}
.tree ul{padding-top:22px}
.tree li{position:relative;padding:22px 8px 0;display:flex;flex-direction:column;align-items:center}
.tree>li{padding-top:0}
.tree li::before,.tree li::after{content:"";position:absolute;top:0;width:50%;height:22px;border-top:2px solid var(--line)}
.tree li::before{right:50%}.tree li::after{left:50%;border-left:2px solid var(--line)}
.tree li:only-child::before,.tree li:only-child::after{display:none}
.tree li:first-child::before,.tree li:last-child::after{border-top:0}
.tree li:last-child::before{border-right:2px solid var(--line);border-radius:0 8px 0 0}
.tree li:first-child::after{border-radius:8px 0 0 0}
.tree>li::before,.tree>li::after{display:none}
.tree ul::before{content:"";position:absolute;top:0;left:50%;height:22px;border-left:2px solid var(--line)}
.node{width:190px;background:var(--card);border:1px solid var(--line);border-top:4px solid var(--c,var(--brand));border-radius:12px;padding:10px;text-align:center;cursor:pointer;transition:.15s}
.node:hover{box-shadow:0 6px 18px rgba(0,0,0,.15);transform:translateY(-2px)}
.node.hit{background:var(--sel);border-color:var(--brand)}
.node.dim{opacity:.25}
.av{width:44px;height:44px;border-radius:50%;background:var(--c,var(--brand));color:#fff;font-weight:700;display:grid;place-items:center;margin:0 auto 6px}
.node b{display:block;font-size:14px}.node span{color:var(--muted);font-size:12px}
.node .extra{display:none;font-size:11px;color:var(--muted);margin-top:6px;border-top:1px dashed var(--line);padding-top:6px}
.detailed .node .extra{display:block}
.compact .node{width:150px;padding:8px}.compact .av{width:32px;height:32px;font-size:12px}
.drawer{position:fixed;top:0;right:0;height:100%;width:min(460px,100%);background:#06141b;color:#e6f2f1;border-left:1px solid #1d3a3c;padding:0 0 24px;transform:translateX(105%);transition:.25s;z-index:20;overflow:auto}
.drawer.open{transform:none}
.drawer .x{position:absolute;top:calc(10px + env(safe-area-inset-top,0px));right:14px;font-size:22px;line-height:1;width:42px;height:42px;padding:0;border-radius:50%;background:#0e2a30;color:#fff;border:0;z-index:2}
.ban{height:150px;background:linear-gradient(135deg,#14485a,var(--c) 70%,#3fb68b)}
.ring{width:120px;height:120px;border-radius:50%;border:4px solid #3fb68b;background:var(--c);display:grid;place-items:center;font-size:38px;font-weight:700;margin:-62px auto 0;position:relative;color:#fff}
.dl{text-align:center;color:#7fe0c4;font-weight:700;letter-spacing:.15em;text-transform:uppercase;font-size:12px;margin-top:18px}
.nm{text-align:center;font:700 34px/1.1 Georgia,serif;margin:6px 16px}
.rl{text-align:center;color:#7fe0c4;font-weight:700;font-size:17px;margin-top:10px}
.bdg{width:max-content;max-width:90%;margin:14px auto;border:1px solid #6b8482;border-radius:99px;padding:6px 16px;font-size:12px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:#8aa3a0}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;padding:0 20px}
.cell{background:#0c1f29;border:1px solid #1d3a3c;border-radius:14px;padding:14px}
.cell[data-open]{cursor:pointer}.cell[data-open]:hover{border-color:#3fb68b}.cell small{display:block;color:#9db5b3}.cell b{display:block;font-size:16px;word-break:break-word}
.note{color:#9db5b3;padding:0 20px;margin:18px 0}
.hd{margin:20px 20px 12px;padding-top:18px;border-top:1px solid #1d3a3c;font-size:22px}
.rep{display:flex;align-items:center;gap:12px;margin:0 20px 10px;padding:12px;background:#0c1f29;border:1px solid #1d3a3c;border-radius:14px;cursor:pointer}
.rep:hover{border-color:#3fb68b}.rep>div:nth-child(2){flex:1}.rep b{display:block}.rep span{color:#9db5b3;font-size:13px}.rep i{font-style:normal;font-size:22px;color:#9db5b3}
.mini{width:44px;height:44px;border-radius:50%;background:var(--c);display:grid;place-items:center;font-weight:700;color:#fff}
.back{position:fixed;inset:0;background:rgba(0,0,0,.4);opacity:0;pointer-events:none;transition:.25s;z-index:10}.back.open{opacity:1;pointer-events:auto}
.adm{position:fixed;inset:0;z-index:30;background:var(--bg);overflow:auto;padding:calc(16px + env(safe-area-inset-top,0px)) 16px 24px}
.adm[hidden]{display:none}.ab{max-width:1100px;margin:0 auto}
.ah{display:flex;justify-content:space-between;align-items:center;gap:8px;margin-bottom:14px}.ah h2{margin:0}
.ac{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:16px;align-items:start}
@media(max-width:800px){.ac{grid-template-columns:1fr}}
.pan{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:16px}
.pan label{display:block;font-size:12px;color:var(--muted);margin:10px 0 3px}
.pan input,.pan select,.pan textarea{width:100%;font:inherit;padding:8px 10px;border:1px solid var(--line);border-radius:8px;background:var(--bg);color:var(--text)}
.pri{background:var(--brand);color:#fff;border-color:var(--brand)}
.ar{display:flex;gap:6px;align-items:center;padding:8px 0;border-bottom:1px solid var(--line)}.ar div{flex:1;min-width:0}.ar b,.ar span{display:block}.ar span{font-size:12px;color:var(--muted)}
#aPrev img{width:64px;height:64px;border-radius:50%;object-fit:cover;margin-top:8px}
.av img,.ring img,.mini img{width:100%;height:100%;border-radius:50%;object-fit:cover}
/* ---- Animations ---- */
@keyframes rise{from{opacity:0;transform:translateY(18px)}to{opacity:1;transform:none}}
@keyframes pop{from{opacity:0;transform:scale(.7) translateY(10px)}to{opacity:1;transform:none}}
@keyframes fadeIn{from{opacity:0}to{opacity:1}}
@keyframes flow2{0%,100%{background-position:0% 50%}50%{background-position:100% 50%}}
@keyframes glow{0%,100%{box-shadow:0 0 0 0 rgba(63,182,139,.55)}50%{box-shadow:0 0 0 14px rgba(63,182,139,0)}}
@keyframes float{0%,100%{transform:translateY(0)}50%{transform:translateY(-4px)}}
@keyframes sweep{0%{transform:translateX(-100%)}60%,100%{transform:translateX(100%)}}
@keyframes hitp{0%,100%{box-shadow:0 0 0 0 rgba(0,169,157,.55)}50%{box-shadow:0 0 0 10px rgba(0,169,157,0)}}
@keyframes slideDown{from{opacity:0;transform:translateY(-14px)}to{opacity:1;transform:none}}
.site-header{animation:slideDown .6s backwards}
.logo{animation:float 4s ease-in-out infinite}
.eyebrow{display:inline-block;animation:rise .6s .1s backwards}
h1{animation:rise .7s .2s backwards}
h1 em{background:linear-gradient(90deg,var(--brand),#3fb68b,#3b82f6,var(--brand));background-size:300% 100%;-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;animation:flow2 6s ease-in-out infinite}
.hero p{animation:rise .7s .35s backwards}
.stat{position:relative;overflow:hidden;animation:pop .7s .3s backwards}
.stat::after{content:"";position:absolute;inset:0;background:linear-gradient(110deg,transparent 30%,rgba(255,255,255,.35) 50%,transparent 70%);transform:translateX(-100%);animation:sweep 3.5s 1.2s infinite}
.toolbar{animation:rise .7s .45s backwards}
.canvas{animation:fadeIn .9s .55s backwards}
button{transition:transform .15s,border-color .15s,background .15s}
button:active{transform:scale(.94)}
#theme:hover{transform:rotate(180deg)}
.node{animation:pop .55s cubic-bezier(.2,.8,.2,1) backwards}
.node.hit{animation:hitp 1.4s ease-in-out infinite}
.tree li::before,.tree li::after,.tree ul::before{animation:fadeIn .9s .4s backwards}
.ban{background-size:250% 250%;animation:flow2 9s ease-in-out infinite}
.ring{animation:pop .6s .1s backwards,glow 2.6s 1s infinite}
#profile>.dl,#profile>.nm,#profile>.rl,#profile>.bdg,#profile>.note,#profile>.hd{animation:rise .5s backwards}
#profile>.dl{animation-delay:.15s}#profile>.nm{animation-delay:.2s}#profile>.rl{animation-delay:.25s}#profile>.bdg{animation-delay:.3s}#profile>.note{animation-delay:.5s}#profile>.hd{animation-delay:.55s}
.cell,.rep{animation:rise .5s backwards}
.adm{animation:fadeIn .3s}
.pan{animation:rise .5s backwards}.pan:nth-child(2){animation-delay:.1s}
/* ---- Liquid glass + living background ---- */
:root{--glass:rgba(255,255,255,.38);--gb:rgba(255,255,255,.65);--gs:rgba(0,70,70,.16)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--glass:rgba(22,48,52,.45);--gb:rgba(255,255,255,.15);--gs:rgba(0,0,0,.45)}}
:root[data-theme="dark"]{--glass:rgba(22,48,52,.45);--gb:rgba(255,255,255,.15);--gs:rgba(0,0,0,.45)}
.bg{position:fixed;inset:0;z-index:-1;overflow:hidden}
.bg i{position:absolute;filter:blur(70px);opacity:.7;border-radius:60% 40% 55% 45%/50% 60% 40% 50%;animation:drift 18s ease-in-out infinite alternate,morph 11s ease-in-out infinite alternate}
.bg i:nth-child(1){width:46vmax;height:46vmax;left:-10vmax;top:-12vmax;background:#00c2b3}
.bg i:nth-child(2){width:40vmax;height:40vmax;right:-12vmax;top:8vh;background:#3b82f6;animation-duration:23s,13s;animation-delay:-6s,-3s}
.bg i:nth-child(3){width:38vmax;height:38vmax;left:18vw;bottom:-16vmax;background:#c084fc;animation-duration:27s,15s;animation-delay:-12s,-6s}
.bg i:nth-child(4){width:24vmax;height:24vmax;right:22vw;bottom:6vh;background:#fbbf24;opacity:.45;animation-duration:20s,9s;animation-delay:-9s,-2s}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]) .bg i{opacity:.4}}
:root[data-theme="dark"] .bg i{opacity:.4}
@keyframes drift{0%{transform:translate(0,0) scale(1)}50%{transform:translate(9vmax,6vmax) scale(1.15)}100%{transform:translate(-6vmax,11vmax) scale(.95)}}
@keyframes morph{0%{border-radius:60% 40% 55% 45%/50% 60% 40% 50%}50%{border-radius:40% 60% 45% 55%/60% 40% 60% 40%}100%{border-radius:55% 45% 60% 40%/45% 55% 45% 55%}}
.site-header,.canvas,.pan,.stat2,.toolbar input,.toolbar select,.node,button{-webkit-backdrop-filter:blur(18px) saturate(170%);backdrop-filter:blur(18px) saturate(170%)}
.site-header,.canvas,.pan,.stat2{background:var(--glass);border-color:var(--gb);box-shadow:inset 0 1px 0 var(--gb),inset 0 -1px 0 rgba(255,255,255,.07),0 10px 34px var(--gs)}
button,.toolbar input,.toolbar select{background:var(--glass);border-color:var(--gb);box-shadow:inset 0 1px 0 var(--gb)}
.pan input,.pan select,.pan textarea{background:var(--glass);border-color:var(--gb)}
.node{position:relative;overflow:hidden;background:var(--glass);border-left-color:var(--gb);border-right-color:var(--gb);border-bottom-color:var(--gb);box-shadow:inset 0 1px 0 var(--gb),0 8px 24px var(--gs)}
.node::before{content:"";position:absolute;inset:0;pointer-events:none;background:linear-gradient(120deg,rgba(255,255,255,.45),transparent 40%,transparent 65%,rgba(255,255,255,.15))}
.node::after{content:"";position:absolute;top:0;bottom:0;width:60%;left:-80%;pointer-events:none;background:linear-gradient(100deg,transparent,rgba(255,255,255,.55),transparent);transform:skewX(-20deg)}
.node:hover::after{left:130%;transition:left .9s}
.stats{display:flex;gap:12px;flex-wrap:wrap;align-items:stretch}
.stat{background:linear-gradient(135deg,rgba(0,169,157,.8),rgba(59,130,246,.6));border:1px solid var(--gb);box-shadow:inset 0 1px 0 rgba(255,255,255,.5),0 10px 34px var(--gs);-webkit-backdrop-filter:blur(18px);backdrop-filter:blur(18px)}
.stat2{border:1px solid var(--gb);border-radius:16px;padding:16px 20px;min-width:110px;text-align:center;animation:pop .7s .45s backwards}
.stat2 strong{display:block;font-size:30px;line-height:1.1;color:var(--brand);font-variant-numeric:tabular-nums}.stat2 span{font-size:12px;color:var(--muted)}
.stat strong{font-variant-numeric:tabular-nums}
.sc{font-variant-ligatures:none}
.drawer{background:rgba(6,20,27,.7);-webkit-backdrop-filter:blur(26px) saturate(160%);backdrop-filter:blur(26px) saturate(160%);border-left:1px solid rgba(255,255,255,.16);box-shadow:-20px 0 60px rgba(0,0,0,.35)}
.cell,.rep{background:rgba(255,255,255,.07);border-color:rgba(255,255,255,.16);box-shadow:inset 0 1px 0 rgba(255,255,255,.14);-webkit-backdrop-filter:blur(10px);backdrop-filter:blur(10px)}
.back{-webkit-backdrop-filter:blur(4px);backdrop-filter:blur(4px)}
.adm{background:color-mix(in srgb,var(--bg) 55%,transparent);-webkit-backdrop-filter:blur(22px);backdrop-filter:blur(22px)}
/* ---- More motion: background, click, scroll ---- */
.bg{inset:-30vh 0;transform:translateY(max(-25vh,calc(var(--sy,0)*-.08px)))}
.bg::before{content:"";position:absolute;inset:-50%;background:conic-gradient(from 0deg,transparent,rgba(0,194,179,.2),transparent 30%,rgba(192,132,252,.18),transparent 60%,rgba(59,130,246,.18),transparent);animation:spin 40s linear infinite}
.bg::after{content:"";position:absolute;inset:-60px;background-image:linear-gradient(var(--gb) 1px,transparent 1px),linear-gradient(90deg,var(--gb) 1px,transparent 1px);background-size:60px 60px;opacity:.35;animation:gridmove 12s linear infinite;-webkit-mask-image:radial-gradient(ellipse at 50% 40%,#000 15%,transparent 75%);mask-image:radial-gradient(ellipse at 50% 40%,#000 15%,transparent 75%)}
.bg b{position:absolute;width:12vmax;height:12vmax;border:2px solid rgba(0,169,157,.4);border-radius:50%;animation:ring 7s ease-out infinite}
.bg b:nth-child(5){left:12%;top:30%}.bg b:nth-child(6){right:15%;top:55%;animation-delay:-2.5s;border-color:rgba(192,132,252,.45)}.bg b:nth-child(7){left:45%;bottom:18%;animation-delay:-5s;border-color:rgba(59,130,246,.45)}
@keyframes spin{to{transform:rotate(360deg)}}
@keyframes gridmove{to{transform:translate(60px,60px)}}
@keyframes ring{0%{transform:scale(.2);opacity:.9}100%{transform:scale(3.2);opacity:0}}
canvas#fx{position:fixed;inset:0;z-index:-1;pointer-events:none}
#prog{position:fixed;top:0;left:0;width:100%;height:3px;transform-origin:left;transform:scaleX(var(--p,0));background:linear-gradient(90deg,#00c2b3,#3b82f6,#c084fc);z-index:40}
.site-header{position:sticky;top:env(safe-area-inset-top,0px);z-index:5;transition:padding .3s,box-shadow .3s}
.site-header.small{padding:8px 20px;box-shadow:0 8px 30px var(--gs)}
.hero{transform:translateY(calc(var(--sy,0)*.08px));opacity:max(.2,calc(1 - var(--sy,0)/900))}
#toTop{position:fixed;right:18px;bottom:calc(18px + env(safe-area-inset-bottom,0px));width:44px;height:44px;border-radius:50%;padding:0;font-size:20px;z-index:15;opacity:0;pointer-events:none;transform:translateY(20px) scale(.8)}
#toTop.show{opacity:1;pointer-events:auto;transform:none}
.rv{opacity:0;transform:translateY(40px) scale(.97);transition:opacity .7s,transform .7s cubic-bezier(.2,.8,.2,1);transition-delay:var(--d,0s)}
.rv.in{opacity:1;transform:none}
.depts{margin-top:30px;padding-bottom:30px}.sh{margin:0 0 14px;font-size:26px}
.dgrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(210px,1fr));gap:14px}
.dc{background:var(--glass);border:1px solid var(--gb);border-radius:16px;padding:16px;box-shadow:inset 0 1px 0 var(--gb),0 10px 30px var(--gs);-webkit-backdrop-filter:blur(18px) saturate(170%);backdrop-filter:blur(18px) saturate(170%)}
.dc.in:hover{transform:translateY(-5px)}
.dc h4{margin:0;display:flex;align-items:center;gap:8px}.dc h4 i{width:10px;height:10px;border-radius:50%;background:var(--c)}
.dc strong{display:block;font-size:36px;line-height:1.1;font-variant-numeric:tabular-nums;margin:8px 0}
.dc small{color:var(--muted)}
.bar{height:8px;border-radius:9px;background:rgba(128,128,128,.22);overflow:hidden;margin-bottom:6px}.bar u{display:block;height:100%;width:0;border-radius:9px;background:var(--c);transition:width 1.3s .25s cubic-bezier(.2,.8,.2,1)}
.dc.in .bar u{width:var(--w)}
button,.rep,.cell{position:relative;overflow:hidden}
.drawer .x{position:absolute}
.rip{position:absolute;border-radius:50%;pointer-events:none;background:rgba(255,255,255,.55);transform:translate(-50%,-50%) scale(0);animation:ripple .65s ease-out forwards;z-index:3}
@keyframes ripple{to{transform:translate(-50%,-50%) scale(1);opacity:0}}
.bst{position:fixed;left:0;top:0;pointer-events:none;z-index:99}
.bst i{position:absolute;width:8px;height:8px;left:-4px;top:-4px;border-radius:50%;background:var(--c);animation:spark .75s cubic-bezier(.1,.7,.3,1) forwards}
.bst u{position:absolute;width:12px;height:12px;left:-6px;top:-6px;border:2px solid var(--brand);border-radius:50%;animation:shock .7s ease-out forwards}
@keyframes spark{to{transform:translate(var(--x),var(--y)) scale(.2);opacity:0}}
@keyframes shock{from{transform:scale(1);opacity:.9}to{transform:scale(9);opacity:0}}
/* ---- Theme colours ---- */
:root{--a2:#3b82f6;--a3:#c084fc}
.bg i{transition:none}
.bg i:nth-child(1){background:var(--brand)}.bg i:nth-child(2){background:var(--a2)}.bg i:nth-child(3){background:var(--a3)}.bg i:nth-child(4){background:color-mix(in srgb,var(--a3) 50%,#fbbf24)}
.bg::before{background:conic-gradient(from 0deg,transparent,color-mix(in srgb,var(--brand) 22%,transparent),transparent 30%,color-mix(in srgb,var(--a3) 20%,transparent),transparent 60%,color-mix(in srgb,var(--a2) 20%,transparent),transparent)}
.bg b{border-color:color-mix(in srgb,var(--brand) 45%,transparent)}.bg b:nth-child(6){border-color:color-mix(in srgb,var(--a3) 45%,transparent)}.bg b:nth-child(7){border-color:color-mix(in srgb,var(--a2) 45%,transparent)}
.stat{background:linear-gradient(135deg,color-mix(in srgb,var(--brand) 82%,transparent),color-mix(in srgb,var(--a2) 62%,transparent))}
h1 em{background-image:linear-gradient(90deg,var(--brand),var(--a2),var(--a3),var(--brand))}
#prog{background:linear-gradient(90deg,var(--brand),var(--a2),var(--a3))}
.ring{border-color:var(--brand)}
.dl,.rl{color:color-mix(in srgb,var(--brand) 55%,white)}
.cell[data-open]:hover,.rep:hover{border-color:var(--brand)}
#themeBtn{position:fixed;left:18px;bottom:calc(18px + env(safe-area-inset-bottom,0px));width:46px;height:46px;border-radius:50%;padding:0;font-size:20px;z-index:15}
